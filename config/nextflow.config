params {
    gencode = true
    save_reference = true
}

process {
    withName: '.*:TXIMETA_TXIMPORT' {
        ext.singularity_pull_docker_container = true
    }

    withName: '.*:SALMON_QUANT' {
        time = '24.h'
    }
    withName: 'NFCORE_RNASEQ:RNASEQ:QUANTIFY_BAM:SALMON:SALMON_QUANT' {
        memory = 64.GB
    }
}
