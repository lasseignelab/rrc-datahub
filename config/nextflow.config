params {
    gencode        = true
    save_reference = true
}

executor {
    queueSize       = 30
    exitReadTimeout = '15 min'
}

process {
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) || task.exitStatus == Integer.MAX_VALUE ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: '.*:TXIMETA_TXIMPORT' {
        ext.singularity_pull_docker_container = true
    }

    withName: '.*:QUANTIFY_BAM_SALMON:SALMON_QUANT' {
        memory = { 96.GB * task.attempt }
    }
}
